# ============================================================
# Starter App - Frontend Environment Variables (Template)
# Copy this file to .env and fill in real values.
# ============================================================

# ---- API Configuration ----
# Backend API base URL. Must match backend PORT (5000) + API_PREFIX (api/v1).
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# ============================================================
# Notes:
#   - NODE_ENV is set automatically by Next.js. Do NOT set it here.
#   - Auth uses httpOnly cookies set by the backend (withCredentials: true).
#   - Image uploads go through the backend /uploads endpoint.
#
# ---- IMPORTANT: Build-time vs Runtime (deployment) ----
#   NEXT_PUBLIC_* vars are INLINED at BUILD time, not runtime.
#   On Render/Vercel, set NEXT_PUBLIC_API_URL in the environment BEFORE the
#   build runs, e.g.:
#     NEXT_PUBLIC_API_URL=https://starter-backend.onrender.com/api/v1
# ============================================================

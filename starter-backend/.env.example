# =============================================================================
# Starter App Backend — Environment Variables
# =============================================================================
# Copy this file to `.env` and fill in real values.
#   cp .env.example .env
#
# Rules:
#   - NEVER commit your real `.env` file (it's in .gitignore).
#   - In production set these in the dashboard, NOT in a file.
#   - Values with spaces or special characters should be wrapped in quotes.
# =============================================================================


# -----------------------------------------------------------------------------
# APPLICATION
# -----------------------------------------------------------------------------

# Runtime environment: "development" | "production" | "test"
NODE_ENV=development

# Port the server listens on.
PORT=5000

# Shown in logs and Swagger docs title.
APP_NAME="Starter App API"

# API version label, shown in Swagger.
APP_VERSION=1.0.0

# Global route prefix. All endpoints live under this, e.g. /api/v1/auth/login
API_PREFIX=api/v1

# -----------------------------------------------------------------------------
# CORS_ORIGIN  (Cross-Origin Resource Sharing)
# -----------------------------------------------------------------------------
# Controls which frontend URLs are allowed to call this API from a browser.
#
# FORMAT:
#   - One origin:     https://starter-frontend.onrender.com
#   - Multiple:       comma-separated, NO spaces, NO trailing slash
#
# EXAMPLES:
#   CORS_ORIGIN=*
#   CORS_ORIGIN=https://starter-frontend.onrender.com,http://localhost:3000
# -----------------------------------------------------------------------------
CORS_ORIGIN=*


# -----------------------------------------------------------------------------
# DATABASE
# -----------------------------------------------------------------------------
# PostgreSQL connection string.
#
# Format: postgresql://USER:PASSWORD@HOST:PORT/DB_NAME?schema=public
#
# Local dev:
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/starter_app?schema=public"


# -----------------------------------------------------------------------------
# JWT (Authentication)
# -----------------------------------------------------------------------------
# Secret used to sign access tokens. Use a LONG random string in production.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# How long an access token is valid. Examples: 1d, 12h, 3600s
JWT_EXPIRES_IN=1d


# -----------------------------------------------------------------------------
# CLOUDINARY (Image / File Uploads)
# -----------------------------------------------------------------------------
# Find these in your Cloudinary dashboard: https://console.cloudinary.com
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret


# -----------------------------------------------------------------------------
# RATE LIMITING
# -----------------------------------------------------------------------------
# Time window (in seconds) for counting requests per client.
RATE_LIMIT_TTL=60

# Max number of requests allowed per client within RATE_LIMIT_TTL seconds.
RATE_LIMIT_LIMIT=100


# -----------------------------------------------------------------------------
# FILE UPLOAD
# -----------------------------------------------------------------------------
# Max upload size in bytes. Default: 10485760 = 10 MB
MAX_FILE_SIZE=10485760
